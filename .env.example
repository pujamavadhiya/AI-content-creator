# ========================================================
# Sevencore AI Content Intelligence & Generation Platform
# Environment Configuration
# ========================================================

# General & Security
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change_this_to_a_super_secret_key_at_least_32_chars_long
JWT_SECRET_KEY=change_this_to_another_super_secret_jwt_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CREDENTIAL_ENCRYPTION_KEY=gAAAAABl-sample-fernet-key-32-urlsafe-base64-bytes=

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database
# For SQLite local development: sqlite+aiosqlite:///./data/app.db
# For PostgreSQL (Docker/Production): postgresql+asyncpg://postgres:postgres@localhost:5432/sevencore_ai
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Vector Database (Qdrant)
# For local embedded storage: leave empty or :memory: or ./data/qdrant
# For standalone/Docker Qdrant: http://localhost:6333
QDRANT_URL=./data/qdrant
QDRANT_API_KEY=

# Cache / Queue (Redis)
REDIS_URL=redis://localhost:6379/0

# AI Provider Settings (Gemini Primary Default)
DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI Configuration (Optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic Configuration (Optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Storage Configuration
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
MAX_UPLOAD_SIZE_MB=25

# SEO Providers (Optional)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
